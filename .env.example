VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated Google account emails allowed on admin-only pages
# (Store Orders, Technicians, Dispatch Board)
VITE_ADMIN_EMAILS=dad@example.com,you@example.com

# --- api/lead.js + api/sign-agreement.js: shared Zoho mailbox -----------
# Same mailbox already configured for Firebase functions. Set these in
# Vercel (Production scope). Powers two things:
#   1. Owner notification email on new demo-form submissions
#   2. The signed-agreement record from /agreement (the actual signature
#      capture) — without SMTP_PASS, signing still "succeeds" for the
#      signer but the record is only logged to Vercel function logs, NOT
#      emailed anywhere. Set this before sending anyone a /agreement link.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
FROM_EMAIL=support@fieldsta.com
SMTP_PASS=
# Where new-lead alerts AND signed-agreement records are sent. Defaults to
# FROM_EMAIL if unset.
NOTIFY_EMAIL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated Google account emails allowed on admin-only pages
# (Store Orders, Technicians, Dispatch Board)
VITE_ADMIN_EMAILS=dad@example.com,you@example.com

# --- api/lead.js: owner notification email on new demo requests ---------
# Same Zoho mailbox already configured for Firebase functions. Set these
# in Vercel (Production scope) — without SMTP_PASS the notification is
# silently skipped and the form still works normally.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
FROM_EMAIL=support@fieldsta.com
SMTP_PASS=
# Where the "new demo request" alert is sent. Defaults to FROM_EMAIL if unset.
NOTIFY_EMAIL=
